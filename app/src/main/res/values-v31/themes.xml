<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nanobotkt" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Android 12+ 启动图标/背景沿用 MD3 浅色基线；系统栏图标由 Compose 按实际主题同步。 -->
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/md3_light_background</item>
        <item name="android:colorAccent">@color/md3_light_primary</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/md3_light_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
