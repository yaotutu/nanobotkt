<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        深色基础主题与 Compose 的 NanobotDarkColorScheme 保持同一背景角色。
        API 27 专属导航栏属性由 values-night-v27/themes.xml 单独覆盖。
    -->
    <style name="Theme.Nanobotkt.Base" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/md3_dark_background</item>
        <item name="android:colorAccent">@color/md3_dark_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.Nanobotkt" parent="Theme.Nanobotkt.Base" />
</resources>
