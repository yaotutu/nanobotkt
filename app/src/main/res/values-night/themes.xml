<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nanobotkt" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- 深色启动窗口与 Compose 的 NanobotDarkColorScheme 保持同一背景角色。 -->
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/md3_dark_background</item>
        <item name="android:colorAccent">@color/md3_dark_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
