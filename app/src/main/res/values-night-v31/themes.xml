<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nanobotkt" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Android 12+ 深色启动窗口，避免进入 Compose 前短暂闪现浅色背景。 -->
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/md3_dark_background</item>
        <item name="android:colorAccent">@color/md3_dark_primary</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/md3_dark_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
